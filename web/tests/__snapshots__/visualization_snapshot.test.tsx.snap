exports[`visualization layer snapshot > renders deterministic timeline view 1`] = `"<article class="drilldown-section visualization-shell"><h3>Visualization Layer (Data-driven, deterministic)</h3><p class="help-text">Sources: <code>artifacts/failure_surface_baseline.v1.json</code>, <code>artifacts/optimization_frontier_realistic.v1.json</code>, <code>artifacts/objective_score_baseline.v1.json</code></p><div class="visualization-toolbar"><label class="checkbox-row visualization-toggle"><input type="checkbox" checked=""/><span>Visualization: ON</span></label></div><div class="visualization-tab-row" role="tablist" aria-label="visualization views"><button type="button" role="tab" aria-selected="true" class="visualization-tab active">Timeline (A)</button><button type="button" role="tab" aria-selected="false" class="visualization-tab">Frontier (B)</button></div><article class="visualization-pane" aria-label="mission timeline visualization"><header class="visualization-pane-header"><h4>Mission Timeline (S0-S3)</h4><p class="help-text mono-cell">outcome=FAIL | p_success=34.684%</p><p class="help-text mono-cell">failure_mode=DATA_CORRUPTION_RADIATION | failure_stage=S3</p></header><div class="timeline-grid"><section class="timeline-stage-card" aria-label="stage S0"><div class="timeline-stage-header"><p class="timeline-stage-label">S0</p><p class="timeline-stage-status pass">PASS</p></div><p class="timeline-stage-summary">Stage modules passed: env.</p></section><section class="timeline-stage-card" aria-label="stage S1"><div class="timeline-stage-header"><p class="timeline-stage-label">S1</p><p class="timeline-stage-status pass">PASS</p></div><p class="timeline-stage-summary">Stage modules passed: control, traj.</p></section><section class="timeline-stage-card" aria-label="stage S2"><div class="timeline-stage-header"><p class="timeline-stage-label">S2</p><p class="timeline-stage-status pass">PASS</p></div><p class="timeline-stage-summary">Stage modules passed: shield, thermal.</p></section><section class="timeline-stage-card is-failure-point" aria-label="stage S3"><div class="timeline-stage-header"><p class="timeline-stage-label">S3</p><p class="timeline-stage-status fail">FAIL</p></div><p class="timeline-stage-summary">Threshold-derived failure attribution: DATA_CORRUPTION_RADIATION (success threshold not met).</p></section></div><section class="timeline-drivers"><h5>Dominant drivers (top-3)</h5><p class="help-text mono-cell">method=OAT; confidence=0.72</p><ol class="compact-list"><li><a href="#parameters/capsule_model.data_media_survival_margin" class="mono-cell">capsule_model.data_media_survival_margin</a> <span class="help-text">(Stage-specific attribution: reduced-order p_data_intact depends directly on media survivability margin.)</span></li><li><a href="#parameters/capsule_model.material_degradation_mu_1_per_year" class="mono-cell">capsule_model.material_degradation_mu_1_per_year</a> <span class="help-text">(Stage-specific attribution: reduced-order p_data_intact is penalized by the degradation-rate prior over mission horizon.)</span></li><li><a href="#parameters/environment_model.radiative_flux_w_m2" class="mono-cell">environment_model.radiative_flux_w_m2</a> <span class="help-text">(Stage-specific attribution: radiative loading remains an explicit data-integrity stress term.)</span></li></ol></section></article></article>"`;
