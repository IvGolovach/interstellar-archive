exports[`visualization layer snapshot > renders deterministic frontier view 1`] = `
"<article class="drilldown-section visualization-shell"><h3>Visualization Layer (Data-driven, deterministic)</h3><p class="help-text">Sources: <code>artifacts/failure_surface_baseline.v1.json</code>, <code>artifacts/optimization_frontier_realistic.v1.json</code>, <code>artifacts/objective_score_baseline.v1.json</code></p><div class="visualization-toolbar"><label class="checkbox-row visualization-toggle"><input type="checkbox" checked=""/><span>Visualization: ON</span></label></div><div class="visualization-tab-row" role="tablist" aria-label="visualization views"><button type="button" role="tab" aria-selected="false" class="visualization-tab">Timeline (A)</button><button type="button" role="tab" aria-selected="true" class="visualization-tab active">Frontier (B)</button></div><article class="visualization-pane" aria-label="optimization frontier visualization"><header class="visualization-pane-header"><h4>Optimization Frontier (2D Pareto)</h4><p class="help-text mono-cell">x=risk_envelope [0..1], y=p_success [0..1], method=deterministic_latin_hypercube, q=0.05</p><p class="help-text mono-cell">points=20, pareto_size=1</p></header><svg class="frontier-plot" viewBox="0 0 700 260" role="img" aria-label="2D frontier scatter"><path class="line-chart-grid" d="M32 32 L668 32
              M32 130 L668 130
              M32 228 L668 228
              M32 228 L32 32
              M668 228 L668 32"></path><circle cx="453.30203328131597" cy="160.01930986124" r="5.4" class="frontier-point frontier-point-pareto"><title>candidate=pt-000; p_success=0.346840; risk_envelope=0.662425; dominant_drivers=capsule_model.data_media_survival_margin,capsule_model.material_degradation_mu_1_per_year,environment_model.radiative_flux_w_m2</title></circle><circle cx="668" cy="228" r="3.8" class="frontier-point"><title>candidate=pt-001; p_success=0.000000; risk_envelope=1.000000; dominant_drivers=capsule_model.data_media_survival_margin,capsule_model.material_degradation_mu_1_per_year,environment_model.radiative_flux_w_m2</title></circle><circle cx="668" cy="228" r="3.8" class="frontier-point"><title>candidate=pt-002; p_success=0.000000; risk_envelope=1.000000; dominant_drivers=capsule_model.data_media_survival_margin,capsule_model.material_degradation_mu_1_per_year,environment_model.radiative_flux_w_m2</title></circle><circle cx="668" cy="228" r="3.8" class="frontier-point"><title>candidate=pt-003; p_success=0.000000; risk_envelope=1.000000; dominant_drivers=capsule_model.data_media_survival_margin,capsule_model.material_degradation_mu_1_per_year,environment_model.radiative_flux_w_m2</title></circle><circle cx="668" cy="228" r="3.8" class="frontier-point"><title>candidate=pt-004; p_success=0.000000; risk_envelope=1.000000; dominant_drivers=capsule_model.data_media_survival_margin,capsule_model.material_degradation_mu_1_per_year,environment_model.radiative_flux_w_m2</title></circle><circle cx="668" cy="228" r="3.8" class="frontier-point"><title>candidate=pt-005; p_success=0.000000; risk_envelope=1.000000; dominant_drivers=capsule_model.data_media_survival_margin,capsule_model.material_degradation_mu_1_per_year,environment_model.radiative_flux_w_m2</title></circle><circle cx="668" cy="228" r="3.8" class="frontier-point"><title>candidate=pt-006; p_success=0.000000; risk_envelope=1.000000; dominant_drivers=capsule_model.data_media_survival_margin,capsul