// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mission mode UX > renders mission mode single-screen layout deterministically 1`] = `"<main class="app-shell mission-mode-shell"><header class="hero mission-overview"><p class="eyebrow">Mission Mode</p><h1>Horizon-Crossing Mission Interface</h1><p class="hero-copy">This interface treats the run as a mission story: stage timeline, parameter controls, deterministic run, and provenance-linked outcomes with explicit assumption boundaries. Physical laws are locked; engineering and speculative controls are explicit.</p><div class="mission-overview-summary"><p>Success contract: <code>p_success = p_hit * p_survival * p_data_intact</code></p><p>Current baseline result: <strong>34.684%</strong> (realistic mode)</p></div><button type="button" class="mission-run-button">🚀 Run Mission</button></header><section class="panel mission-stage-panel"><h2>Mission Stage Timeline (S0-S3)</h2><div class="mission-stage-grid"><article class="mission-stage-card"><header class="mission-stage-card-header"><p class="mission-stage-name">S0</p><span class="mission-stage-status pass">PASS</span></header><p class="mission-stage-description">Initialization and launch assumptions are established.</p><p class="mission-stage-summary">Stage modules passed: env.</p><p class="mission-stage-risk">Low risk</p></article><article class="mission-stage-card"><header class="mission-stage-card-header"><p class="mission-stage-name">S1</p><span class="mission-stage-status pass">PASS</span></header><p class="mission-stage-description">Cruise phase where uncertainty and guidance drift accumulate.</p><p class="mission-stage-summary">Stage modules passed: control, traj.</p><p class="mission-stage-risk">Low risk</p></article><article class="mission-stage-card"><header class="mission-stage-card-header"><p class="mission-stage-name">S2</p><span class="mission-stage-status pass">PASS</span></header><p class="mission-stage-description">Approach and interaction corridor where correction leverage decays.</p><p class="mission-stage-summary">Stage modules passed: shield, thermal.</p><p class="mission-stage-risk">Low risk</p></article><article class="mission-stage-card mission-stage-card-failure"><header class="mission-stage-card-header"><p class="mission-stage-name">S3</p><span class="mission-stage-status fail">FAIL</span></header><p class="mission-stage-description">Data integrity and survivability checkpoint at mission outcome.</p><p class="mission-stage-summary">Threshold-derived failure attribution: DATA_CORRUPTION_RADIATION (success threshold not met).</p><p class="mission-stage-risk">High risk</p></article></div></section><section class="panel mission-control-panel"><h2>Parameter Control Panel</h2><div class="mission-control-top-row"><label class="field compact-field"><span>Scenario</span><select><option value="default.v1" selected="">default.v1</option><option value="optimistic.v1">optimistic.v1</option><option value="pessimistic.v1">pessimistic.v1</option><option value="extreme.v1">extreme.v1</option></select></label><label class="field compact-field"><span>Seed (numeric override)</span><input type="number" step="1" min="0" inputMode="numeric" placeholder="optional" value=""/></label><div class="mission-control-meta"><p>Scenario seed token: default-seed-v1</p><p>Effective seed: default-seed-v1</p><p>Last run: not run yet</p></div></div><div class="mission-physics-locks"><h3>🔒 Physics (Read-only)</h3><p class="help-text">Fundamental physical constraints (not editable).</p><div class="mission-lock-grid"><label class="field"><span>Engine version</span><input disabled="" value="v1"/></label><label class="field"><span>Schema version</span><input disabled="" value="sim_schema.v2"/></label><label class="field"><span>Golden checksum</span><input disabled="" value="bda117f5294cdd3147506d0b3f3f92c99d4113857631230b05bacdd0bd70288c"/></label><label class="field"><span>Risk envelope method</span><input disabled="" value="lower_quantile (q=0.05)"/></label></div></div><div class="mission-engineering-controls"><h3>🧱 Engineering (Editable)</h3><div class="mission-field-grid"><label class="field mission-control-field"><span>Horizon Years (year)</span><input type="number" min="10" max="200" step="0.1" value="80"/><small>Bounds: [10, 200] | Baseline: 80</small></label><label class="field mission-control-field"><span>Step Years (year)</span><input type="number" min="0.25" max="5" step="0.01" value="1"/><small>Bounds: [0.25, 5] | Baseline: 1</small></label><label class="field mission-control-field"><span>Correction Window Years (year)</span><input type="number" min="5" max="100" step="0.1" value="30"/><small>Bounds: [5, 100] | Baseline: 30</small></label><label class="field mission-control-field"><span>Dust Flux Scale (relative)</span><input type="number" min="0.2" max="3.5" step="0.01" value="1"/><small>Bounds: [0.2, 3.5] | Baseline: 1</small></label><label class="field mission-control-field"><span>Encounter Distance Au (AU)</span><input type="number" min="80" max="1500" step="0.1" value="300"/><small>Bounds: [80, 1500] | Baseline: 300</small></label><label class="field mission-control-field"><span>Initial Delta V Mps (m/s)</span><input type="number" min="1" max="120" step="0.1" value="24"/><small>Bounds: [1, 120] | Baseline: 24</small></label><label class="field mission-control-field"><span>Shield Geometry Factor (relative)</span><input type="number" min="0.5" max="2.5" step="0.01" value="1.1"/><small>Bounds: [0.5, 2.5] | Baseline: 1.1</small></label><label class="field mission-control-field"><span>Uncertainty Growth Per Year (1/year)</span><input type="number" min="0.001" max="0.1" step="0.001" value="0.02"/><small>Bounds: [0.001, 0.1] | Baseline: 0.02</small></label></div></div><div class="mission-spec-controls"><h3>🧪 Speculative (Editable)</h3><div class="mission-field-grid"><label class="field mission-control-field"><span>Irreversibility Override (non-physical)</span><input type="number" min="-2" max="2" step="0.01" value="0"/><small>Bounds: [-2, 2] | Baseline: 0</small></label><label class="field mission-control-field"><span>Narrative Leverage Multiplier (non-physical)</span><input type="number" min="0.5" max="2" step="0.01" value="1"/><small>Bounds: [0.5, 2] | Baseline: 1</small></label></div></div></section><section class="panel mission-results-panel"><h2>Results Panel</h2><div class="mission-results-grid"><article class="metric-card"><p class="metric-label">Success probability (p_success)</p><p class="metric-value">0.346840</p><p class="metric-unit">realistic-mode proxy output</p></article><article class="metric-card"><p class="metric-label">Risk envelope</p><p class="metric-value">0.662425</p><p class="metric-unit">lower-tail downside</p></article><article class="metric-card"><p class="metric-label">Failure stage</p><p class="metric-value">S3</p><p class="metric-unit">taxonomy stage</p></article><article class="metric-card"><p class="metric-label">Failure mode</p><p class="metric-value mission-long-value">DATA_CORRUPTION_RADIATION</p><p class="metric-unit">baseline failure surface</p></article></div><div class="mission-drivers"><h3>Dominant drivers</h3><ol class="compact-list"><li><span class="mono-cell">capsule_model.data_media_survival_margin</span></li><li><span class="mono-cell">capsule_model.material_degradation_mu_1_per_year</span></li><li><span class="mono-cell">environment_model.radiative_flux_w_m2</span></li></ol></div></section><section class="panel mission-optimization-panel"><button type="button" class="section-toggle"><span>Optimization Panel</span><span>Show</span></button></section></main>"`;
