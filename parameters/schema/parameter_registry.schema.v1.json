{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IvGolovach/interstellar-archive/blob/main/parameters/schema/parameter_registry.schema.v1.json",
  "title": "Parameter Registry Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "parameter_registry.v1"
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter_id",
          "name",
          "unit",
          "type",
          "default",
          "bounds",
          "category",
          "mode",
          "domain",
          "affects_core_probability",
          "classification",
          "visibility",
          "public_surfaces",
          "audit_scope",
          "used_in",
          "code_refs",
          "json_refs",
          "notes"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "visibility"
              ],
              "properties": {
                "visibility": {
                  "const": "public"
                }
              }
            },
            "then": {
              "properties": {
                "public_surfaces": {
                  "minItems": 1
                },
                "audit_scope": {
                  "const": "mission_parameter"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "visibility"
              ],
              "properties": {
                "visibility": {
                  "const": "internal"
                }
              }
            },
            "then": {
              "properties": {
                "public_surfaces": {
                  "maxItems": 0
                },
                "audit_scope": {
                  "const": "code_literal"
                }
              }
            }
          }
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "minLength": 3
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "scalar",
              "distribution"
            ]
          },
          "default": {
            "type": "number"
          },
          "bounds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "safe",
              "advanced",
              "non_physical"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "realistic",
              "speculative",
              "both"
            ]
          },
          "domain": {
            "type": "string",
            "enum": [
              "realistic",
              "speculative"
            ]
          },
          "affects_core_probability": {
            "type": "boolean"
          },
          "classification": {
            "type": "string",
            "enum": [
              "derived",
              "measured",
              "estimated",
              "assumed",
              "design_choice"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "internal"
            ]
          },
          "public_surfaces": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "browser",
                "optimization"
              ]
            }
          },
          "audit_scope": {
            "type": "string",
            "enum": [
              "mission_parameter",
              "code_literal"
            ]
          },
          "used_in": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "code_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "json_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "realistic_neutral_value": {
            "type": "number"
          },
          "distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "parameters",
              "bounds",
              "evidence_source_ids"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "normal",
                  "lognormal",
                  "uniform",
                  "triangular"
                ]
              },
              "parameters": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "number"
                }
              },
              "bounds": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "evidence_source_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
