{
  "schema_version": "objective_contract.v1",
  "engine_commit": "AUTO",
  "modes": [
    "realistic",
    "speculative"
  ],
  "objective_sets": {
    "realistic": {
      "primary": {
        "metric": "p_success",
        "maximize": true
      },
      "constraints": [
        {
          "id": "no_D_grade_influence",
          "type": "hard",
          "enforced_by": "scripts/ci/parameter_domain_guard.py"
        },
        {
          "id": "evidence_completeness_1.0",
          "type": "hard",
          "enforced_by": "scripts/ci/parameter_evidence_validate.py"
        }
      ],
      "secondary": [
        {
          "metric": "risk_envelope",
          "maximize": false
        }
      ],
      "aggregation": {
        "type": "pareto",
        "dimensions": [
          "p_success",
          "risk_envelope"
        ]
      }
    },
    "speculative": {
      "primary": {
        "metric": "p_success",
        "maximize": true
      },
      "secondary": [],
      "aggregation": {
        "type": "lexicographic",
        "order": [
          "p_success"
        ]
      }
    }
  },
  "definitions": {
    "p_success": {
      "source": "artifacts/p_success_defensibility.json"
    },
    "risk_envelope": {
      "source": "mission/objectives/risk_envelope.v1.json",
      "method": "lower_quantile",
      "quantile": 0.05
    }
  }
}
